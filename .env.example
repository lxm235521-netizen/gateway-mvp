MYSQL_ROOT_PASSWORD=change-me-root-password
DB_NAME=gateway
DB_USER=gateway
DB_PASSWORD=change-me-db-password
DB_HOST=your-db-host
DB_PORT=3310
ADMIN_USER=admin
ADMIN_PASS=change-me-admin-password
POLL_MIN_INTERVAL_SECONDS=6

# Optional prompt-optimization defaults. The normal place to configure these is
# the admin console (global defaults + per-model settings); these variables are
# only fallbacks when a model leaves the field empty.
# OPTIMIZER_BASE_URL=https://api.mmg.lat
# OPTIMIZER_API_KEY=sk-your-optimizer-key
# OPTIMIZER_MODEL=h3-prompt-writing

# Image bed (Zipline) used by the per-channel "base64 -> https" switches
# (convert_base64_to_url / convert_resp_base64_to_url). Defaults point at
# https://files.mmg.lat/api/upload with the built-in token; override here when
# rotating the key or moving to another host.
# IMAGE_BED_UPLOAD_URL=https://files.mmg.lat/api/upload
# IMAGE_BED_TOKEN=zk-your-zipline-token
# IMAGE_BED_AUTH_HEADER=Authorization
# IMAGE_BED_NO_JSON=1

# Optional: on-demand H.264 renditions for /v1/videos/{id}/content?format=h264
# (some upstreams only return HEVC, which Chrome/Firefox cannot decode).
# CONTENT_CACHE_DIR=/app/content-cache
# CONTENT_FALLBACK_ENABLED=0
